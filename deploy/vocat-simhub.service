[Unit]
Description=SIMHub / VoCat VoWiFi SMS gateway (persistent unit, replaces transient vocat-trial)
After=network-online.target
Wants=network-online.target
# Never give up restarting: a crash loop is still better than nobody owning the modems.
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/vocat
# Older hosts may provide a compatible iproute2 in /opt/vocat/bin.
Environment=PATH=/opt/vocat/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=VOCAT_ADDR=0.0.0.0:7575
Environment=VOCAT_DATABASE_PATH=/opt/vocat/data/vocat.db
EnvironmentFile=-/etc/vocat/vocat.env
UMask=0077
ExecStart=/opt/vocat/bin/vocat serve
Restart=always
RestartSec=5s
# Shutdown does a full IMS de-REGISTER for every line; give it time.
TimeoutStopSec=120s
KillMode=mixed
# Allow concurrent multi-profile tunnels and modem descriptors.
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
